+0.1 < sctp: COOKIE_ACK[flgs=0]
+0.0 getsockopt(3, SOL_SOCKET, SO_ERROR, [0], [4]) = 0

// Queue two messages and receive both with one recvmmsg() call.
+0.1 < sctp: DATA[flgs=BE, len=116, tsn=1, sid=1, ssn=0, ppid=111]
* > sctp: SACK[flgs=0, cum_tsn=1, a_rwnd=..., gaps=[], dups=[]]
+0.1 < sctp: DATA[flgs=BE, len=216, tsn=2, sid=2, ssn=0, ppid=222]
* > sctp: SACK[flgs=0, cum_tsn=2, a_rwnd=..., gaps=[], dups=[]]

+0.0 recvmmsg(3, [
	{
